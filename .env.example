# -----------------------------------------------------------------------------
# MarketSphere Environment Configuration Template
# -----------------------------------------------------------------------------

# Database Connection (SQLite by default; for PostgreSQL use postgresql://user:pass@host:5432/marketsphere)
DATABASE_URL="file:./prisma/marketsphere.db"

# JWT Authentication Secret & Lifespan
JWT_SECRET="marketsphere-super-secure-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Google Gemini API (if omitted, falls back to grounded local database engine)
GEMINI_API_KEY=""

# Optional: Stripe Payment Gateway (if omitted, falls back to Safe Test Mode simulator)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
